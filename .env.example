API_KEY="xxx"
model_name="gpt-4o-mini"
API_BASE="xxx"
JUDGE_MODEL="gpt-4.1"
JUDGE_API_KEY="xxx"
JUDGE_BASE_URL="xxx"

# --- Benchmark source roots (data prepared later; preppers resolve local-first) ---
# Free-answer benchmark sources (MathArena family, PHYBench, CL-bench, internal hy_*).
# Per-dataset override: RWKV_FREE_ANSWER_SOURCE_<NAME>=<json/jsonl file or dir>
# RWKV_FREE_ANSWER_SOURCE_ROOT=data/free_answer_sources
# Multi-turn agent-loop benchmark sources (Terminal-Bench, WideSearch, MCP Atlas, internal hy_*).
# Per-dataset override: RWKV_AGENT_LOOP_SOURCE_<NAME>=<json/jsonl file or dir>
# RWKV_AGENT_LOOP_SOURCE_ROOT=data/agent_loop_sources
# Single-turn tool-call sources (legacy agent_tool_call channel).
# RWKV_AGENT_TOOL_CALL_SOURCE_ROOT=data/agent_tool_call_sources

# --- Official verifier assets for agent-loop benchmarks (see docs/agent_loop.md) ---
# Terminal-Bench 2.1 checkout (harbor tasks; official task tests are run in the episode container).
# RWKV_TERMINAL_BENCH_ROOT=/path/to/terminal-bench-2-1
# WideSearch checkout (official infer/eval script is invoked for grading).
# RWKV_WIDESEARCH_OFFICIAL_ROOT=/path/to/WideSearch
# Optional override for the official WideSearch eval invocation.
# RWKV_WIDESEARCH_EVAL_COMMAND="python scripts/run_infer_and_eval_batching.py --stage eval ..."
# MCP-Atlas checkout (official score_claims.py claim-coverage judge; uses JUDGE_* above).
# RWKV_MCP_ATLAS_ROOT=/path/to/mcp-atlas
# Toolathlon checkout (official per-task evaluators, docker/podman required).
# RWKV_TOOLATHLON_ROOT=/path/to/Toolathlon

# --- Live web-search tools for browsing-style agent benchmarks (optional) ---
# Generic JSON POST search endpoint (Serper-style: POST {"q": query} with X-API-KEY header).
# Rows opting into executor {"kind": "web_search"} use these; offline manifest replay needs nothing.
# RWKV_WEB_SEARCH_API_URL=https://google.serper.dev/search
# RWKV_WEB_SEARCH_API_KEY=change-me
# RWKV_WEB_SEARCH_API_KEY_HEADER=X-API-KEY


PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=XXXX
PG_DBNAME=rwkv-eval

# Evaluation dashboard (FastAPI API + Next.js frontend).
#   Backend:  rwkv-skills-dashboard            (serves JSON API on :7860)
#   Frontend: cd client && pnpm dev             (Next.js server on :3000, rewrites /api -> :7860)
#   Optional deploy prefix: NEXT_PUBLIC_BASE_PATH=/new-eval
# Optional overrides for the leaderboard score index location:
# RWKV_SPACE_SCORE_INDEX=/path/to/score_index.jsonl
# RWKV_SPACE_RESULTS_DIR=/path/to/results
# Optional: require a bearer token on the /api/admin/* scheduler control routes.
# RWKV_ADMIN_API_KEY=change-me
