# Evaluation database. Use a dedicated local database by default.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DBNAME=browsecomp_plus_eval

# OpenAI-compatible RWKV-vLLM endpoint used by the evaluator.
INFER_BASE_URL=http://127.0.0.1:18073/v1
INFER_MODEL=rwkv7-model
INFER_API_KEY=change-me

# Official BrowseComp-Plus assets (not included in this repository package).
BROWSECOMP_PLUS_ROOT=/path/to/BrowseComp-Plus
RWKV_BROWSECOMP_PLUS_RETRIEVER=bm25

# The inline/deferred judge uses an OpenAI-compatible judge endpoint.
JUDGE_MODEL=judge-model
JUDGE_API_KEY=change-me
JUDGE_BASE_URL=http://127.0.0.1:8000/v1

# Formal g1h function-calling serialization.
RWKV_FUNCTION_PROMPT_STYLE=rwkv_flower_json
RWKV_TOOL_CALL_IO=rwkv-json
